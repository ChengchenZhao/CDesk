#!/bin/bash

# Description : CUT&RUN data analysis pipeline.
# Author      : Chengchen Zhao
# Version     : 1.0
# Time        : 2021-07-13 13:29:19

###################################################################################################
################################     PARAMETER/FUNCTION DEFINE     ################################
###################################################################################################

data_path=${1} # /data/zhaochengchen/bin/pipeline
result_path=${2} # /data/zhaochengchen/bin/pipeline/CUTRUN
out_name=${3} # CUTRUN_test_single

layout=${4} # single
fastq_file=${5} # "YourFastqFile.fastq.gz" for single-end
                # "YourFastqFile_R1.fastq.gz,YourFastqFile_R2.fastq.gz" for pair-end

mapping_index=${6} # /data/zhaochengchen/Data/mm9/mm9
species=${7} # mm
promoter_file=${8} # /data/zhaochengchen/Data/mm9/mm9.refseq.Promoter
chromInfo=${9} # /data/zhaochengchen/Data/mm9/mm9.len

echo "--------------------------------------------------------------------------------" 
if [ ! -n "${9}" ]
then 
    echo "Parameters are missing, please check your input." 
    exit 2
else 
    echo "CUT&RUN data analysis pipeline is now running..." 
fi 


log_path=${result_path}/log
bam_path=${result_path}/bam
bw_path=${result_path}/bw
peak_path=${result_path}/peak

####################################################################################################
#################################          ANALYSIS STEPS           ################################
####################################################################################################

if [ ! -d "${result_path}" ]; then
  mkdir ${result_path}
fi
if [ ! -d "${log_path}" ]; then
  mkdir ${log_path}
fi
if [ ! -d "${bam_path}" ]; then
  mkdir ${bam_path}
fi
if [ ! -d "${bw_path}" ]; then
  mkdir ${bw_path}
fi
if [ ! -d "${peak_path}" ]; then
  mkdir ${peak_path}
fi
if [ ! -d "${result_path}/${out_name}" ]; then
  mkdir ${result_path}/${out_name}
fi
if [ ! -d "${log_path}/${out_name}" ]; then
  mkdir ${log_path}/${out_name}
fi


# 1.mapping ----------------------------------------------------------------------------------------
echo "1.mapping..."
if [ "${layout}" == "single" ]
then
    nohup trim_galore --gzip -j 3 ${data_path}/${fastq_file} --trim-n -o ${data_path} --no_report_file --basename ${out_name}_treat > ${log_path}/${out_name}/${out_name}.TreatTrimGalore.log 2>&1
    bowtie2 -q -p 10 -x ${mapping_index} -U ${data_path}/${out_name}_treat_trimmed.fq.gz -S ${result_path}/${out_name}/${out_name}.sam > ${log_path}/${out_name}/${out_name}.TreatMapping.log 2>&1
    rm -rf ${data_path}/${out_name}_trimmed.fq.gz

    samtools view -@ 5 -bS ${result_path}/${out_name}/${out_name}.sam > ${result_path}/${out_name}/${out_name}.bam
    samtools sort -@ 5 ${result_path}/${out_name}/${out_name}.bam > ${bam_path}/${out_name}.bam
    rm -rf ${result_path}/${out_name}/${out_name}.sam ${result_path}/${out_name}/${out_name}.bam

    # Remove duplicate reads
    samtools view -@ 5 -H ${bam_path}/${out_name}.bam > ${bam_path}/${out_name}.Filtered.sam
    samtools view -@ 5 -f 0x2 ${bam_path}/${out_name}.bam | awk 'NR % 2 == 1{mapq=$5;forward=$0} NR % 2 == 0{if($5>=30 && mapq>=30 && substr($3,1,3)=="chr" && $3!="chrM") print forward"\n"$0}' >> ${bam_path}/${out_name}.Filtered.sam
    samtools view -@ 5 -bS ${bam_path}/${out_name}.Filtered.sam > ${bam_path}/${out_name}.Filtered.bam
    rm ${bam_path}/${out_name}.Filtered.sam 
    samtools sort -@ 5 -n -o ${bam_path}/${out_name}.Sort.bam ${bam_path}/${out_name}.Filtered.bam
    rm ${bam_path}/${out_name}.Filtered.bam
    samtools fixmate -@ 5 -m ${bam_path}/${out_name}.Sort.bam ${bam_path}/${out_name}.FixMate.bam
    rm ${bam_path}/${out_name}.Sort.bam
    samtools sort -@ 5 -o ${bam_path}/${out_name}.FixMateSorted.bam ${bam_path}/${out_name}.FixMate.bam
    rm ${bam_path}/${out_name}.FixMate.bam
    samtools markdup -@ 5 -r ${bam_path}/${out_name}.FixMateSorted.bam ${bam_path}/${out_name}.bam
    rm ${bam_path}/${out_name}.FixMateSorted.bam
    
    # Generate bigwig file
    macs3 callpeak -f BAM -g ${species} -B -q 0.001 --keep-dup all --SPMR -t ${bam_path}/${out_name}.bam -n ${bam_path}/${out_name}
    bedClip ${bam_path}/${out_name}.bdg ${chromInfo} ${bam_path}/${out_name}.tmp.bdg
    grep -v _ ${bam_path}/${out_name}.tmp.bdg | sort -k1,1 -k2,2n  > ${bam_path}/${out_name}.clean.bdg
    bedGraphToBigWig ${bam_path}/${out_name}.clean.bdg ${chromInfo} ${bw_path}/${out_name}.bw
    rm ${bam_path}/${out_name}*.bdg
    rm ${bam_path}/${out_name}*.bed
    rm ${bam_path}/${out_name}*.xls
    rm ${bam_path}/${out_name}*.narrowPeak

elif [ "${layout}" == "pair" ]
then
    IFS=','
    read -ra fastq_file_arr1 <<< "${fastq_file}"
    nohup trim_galore --gzip -j 3 --paired ${data_path}/${fastq_file_arr1[0]} ${data_path}/${fastq_file_arr1[1]} --trim-n -o ${data_path} --no_report_file --basename ${out_name} > ${log_path}/${out_name}/${out_name}.TrimGalore.log 2>&1
    IFS=','
    bowtie2 -q -p 10 -x ${mapping_index} -1 ${data_path}/${out_name}_val_1.fq.gz -2 ${data_path}/${out_name}_val_2.fq.gz -S ${result_path}/${out_name}/${out_name}.sam > ${log_path}/${out_name}/${out_name}.TreatMapping.log 2>&1
    rm -rf ${data_path}/${out_name}_val_1.fq.gz ${data_path}/${out_name}_val_2.fq.gz

    samtools view -@ 5 -bS ${result_path}/${out_name}/${out_name}.sam > ${result_path}/${out_name}/${out_name}.bam
    samtools sort -@ 5 ${result_path}/${out_name}/${out_name}.bam > ${bam_path}/${out_name}.bam
    rm -rf ${result_path}/${out_name}/${out_name}.sam ${result_path}/${out_name}/${out_name}.bam

    # Remove duplicate reads
    samtools view -@ 5 -H ${bam_path}/${out_name}.bam > ${bam_path}/${out_name}.Filtered.sam
    samtools view -@ 5 -f 0x2 ${bam_path}/${out_name}.bam | awk 'NR % 2 == 1{mapq=$5;forward=$0} NR % 2 == 0{if($5>=30 && mapq>=30 && substr($3,1,3)=="chr" && $3!="chrM") print forward"\n"$0}' >> ${bam_path}/${out_name}.Filtered.sam
    samtools view -@ 5 -bS ${bam_path}/${out_name}.Filtered.sam > ${bam_path}/${out_name}.Filtered.bam
    rm ${bam_path}/${out_name}.Filtered.sam 
    samtools sort -@ 5 -n -o ${bam_path}/${out_name}.Sort.bam ${bam_path}/${out_name}.Filtered.bam
    rm ${bam_path}/${out_name}.Filtered.bam
    samtools fixmate -@ 5 -m ${bam_path}/${out_name}.Sort.bam ${bam_path}/${out_name}.FixMate.bam
    rm ${bam_path}/${out_name}.Sort.bam
    samtools sort -@ 5 -o ${bam_path}/${out_name}.FixMateSorted.bam ${bam_path}/${out_name}.FixMate.bam
    rm ${bam_path}/${out_name}.FixMate.bam
    samtools markdup -@ 5 -r ${bam_path}/${out_name}.FixMateSorted.bam ${bam_path}/${out_name}.bam
    rm ${bam_path}/${out_name}.FixMateSorted.bam
    
    # Generate bigwig file
    macs3 callpeak -f BAMPE -g ${species} -B -q 0.001 --keep-dup all --SPMR -t ${bam_path}/${out_name}.bam -n ${bam_path}/${out_name}
    bedClip ${bam_path}/${out_name}.bdg ${chromInfo} ${bam_path}/${out_name}.tmp.bdg
    grep -v _ ${bam_path}/${out_name}.tmp.bdg | sort -k1,1 -k2,2n  > ${bam_path}/${out_name}.clean.bdg
    bedGraphToBigWig ${bam_path}/${out_name}.clean.bdg ${chromInfo} ${bw_path}/${out_name}.bw
    rm ${bam_path}/${out_name}*.bdg
    rm ${bam_path}/${out_name}*.bed
    rm ${bam_path}/${out_name}*.xls
    rm ${bam_path}/${out_name}*.narrowPeak

else
    echo "The experiment layout should be either 'single' end or 'pair' end."
fi

# 2.peak calling -----------------------------------------------------------------------------
echo "2.peak calling..."
macs14 callpeak -g ${species} -p 1e-5 --keep-dup 1 --nomodel --shiftsize 73 -t ${bam_path}/${out_name}.bam -n ${peak_path}/${out_name}

# 3.Promoter signal calculation ----------------------------------------------------------------------
echo "3.Promoter signal calculation..."
python3 /usr/local/bin/GetBigwigSignal.py ${promoter_file} ${bw_path}/${out_name}.bw ${result_path}/${out_name}/${out_name}.PromoterSignal.tmp 1
cut -f 5 ${promoter_file} | paste - ${result_path}/${out_name}/${out_name}.PromoterSignal.tmp > ${result_path}/${out_name}/${out_name}.PromoterSignal.tmp2
python3 /usr/local/bin/GeneSymbolUniq.py ${result_path}/${out_name}/${out_name}.PromoterSignal.tmp2 ${result_path}/${out_name}/${out_name}.PromoterSignal 0
rm ${result_path}/${out_name}/${out_name}.PromoterSignal.tmp
rm ${result_path}/${out_name}/${out_name}.PromoterSignal.tmp2

echo "Done!"
echo "--------------------------------------------------------------------------------" 
