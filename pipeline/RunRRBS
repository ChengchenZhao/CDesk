#!/bin/bash

# Description : RRBS data analysis pipeline.
# Author      : Chengchen Zhao
# Version     : 1.0
# Time        : 2021-07-13 16:29:34

###################################################################################################
################################     PARAMETER/FUNCTION DEFINE     ################################
###################################################################################################
data_path=${1} # /data/zhaochengchen/bin/pipeline
result_path=${2} # /data/zhaochengchen/bin/pipeline/RRBS
out_name=${3} # RRBS_test_single

layout=${4} # single/pair
fastq_file=${5} # "YourFastqFile.fastq.gz" for single-end
                # "YourFastqFile_R1.fastq.gz,YourFastqFile_R2.fastq.gz" for pair-end

mapping_index=${6} # ${refpath}/annotations/mm9.RRBS.fa
species=${7} # mm
promoter_file=${8} # /data/zhaochengchen/Data/mm9/mm9.refseq.Promoter
chromInfo=${9} # /data/zhaochengchen/Data/mm9/mm9.len

echo "--------------------------------------------------------------------------------" 
if [ ! -n "${9}" ]
then 
    echo "Parameters are missing, please check your input." 
    exit 2
else 
    echo "RRBS-seq data analysis pipeline is now running..." 
fi 


log_path=${result_path}/log
bam_path=${result_path}/bam
bw_path=${result_path}/bw
peak_path=${result_path}/peak

####################################################################################################
#################################          ANALYSIS STEPS           ################################
####################################################################################################

if [ ! -d "${result_path}" ]; then
  mkdir ${result_path}
fi
if [ ! -d "${log_path}" ]; then
  mkdir ${log_path}
fi
if [ ! -d "${bam_path}" ]; then
  mkdir ${bam_path}
fi
if [ ! -d "${bw_path}" ]; then
  mkdir ${bw_path}
fi
if [ ! -d "${peak_path}" ]; then
  mkdir ${peak_path}
fi
if [ ! -d "${result_path}/${out_name}" ]; then
  mkdir ${result_path}/${out_name}
fi
if [ ! -d "${log_path}/${out_name}" ]; then
  mkdir ${log_path}/${out_name}
fi


# 1.mapping ----------------------------------------------------------------------------------------
echo "1.mapping..."
if [ "${layout}" == "single" ]
then
    nohup trim_galore --gzip -j 3 --rrbs ${data_path}/${fastq_file} --trim-n -o ${data_path} --no_report_file --basename ${out_name} > ${log_path}/${out_name}/${out_name}.TrimGalore.log 2>&1
    bsmap -p 10 -a ${data_path}/${out_name}_trimmed.fq.gz -d ${mapping_index} -D C-CGG -w 100 -s 12 -v 0.1 -n 1 -m 32 -x 1000 -R -o ${result_path}/${out_name}/${out_name}.align.sam > ${log_path}/${out_name}/${out_name}.Mapping.log 2>&1
    rm -rf ${data_path}/${out_name}_trimmed.fq.gz

    samtools view -@ 5 -bS ${result_path}/${out_name}/${out_name}.sam > ${result_path}/${out_name}/${out_name}.bam
    samtools sort -@ 5 ${result_path}/${out_name}/${out_name}.bam > ${bam_path}/${out_name}.bam
    rm -rf ${result_path}/${out_name}/${out_name}.sam ${result_path}/${out_name}/${out_name}.bam

    # Remove duplicate reads
    samtools view -@ 5 -H ${bam_path}/${out_name}.bam > ${bam_path}/${out_name}.Filtered.sam
    samtools view -@ 5 -f 0x2 ${bam_path}/${out_name}.bam | awk 'NR % 2 == 1{mapq=$5;forward=$0} NR % 2 == 0{if($5>=30 && mapq>=30 && substr($3,1,3)=="chr" && $3!="chrM") print forward"\n"$0}' >> ${bam_path}/${out_name}.Filtered.sam
    samtools view -@ 5 -bS ${bam_path}/${out_name}.Filtered.sam > ${bam_path}/${out_name}.Filtered.bam
    rm ${bam_path}/${out_name}.Filtered.sam 
    samtools sort -@ 5 -n -o ${bam_path}/${out_name}.Sort.bam ${bam_path}/${out_name}.Filtered.bam
    rm ${bam_path}/${out_name}.Filtered.bam
    samtools fixmate -@ 5 -m ${bam_path}/${out_name}.Sort.bam ${bam_path}/${out_name}.FixMate.bam
    rm ${bam_path}/${out_name}.Sort.bam
    samtools sort -@ 5 -o ${bam_path}/${out_name}.FixMateSorted.bam ${bam_path}/${out_name}.FixMate.bam
    rm ${bam_path}/${out_name}.FixMate.bam
    samtools markdup -@ 5 -r ${bam_path}/${out_name}.FixMateSorted.bam ${bam_path}/${out_name}.bam
    rm ${bam_path}/${out_name}.FixMateSorted.bam

elif [ "${layout}" == "pair" ]
then
    IFS=','
    read -ra fastq_file_arr <<< "${fastq_file}"
    nohup trim_galore --gzip -j 3 --rrbs --paired ${data_path}/${fastq_file_arr[0]} ${data_path}/${fastq_file_arr[1]} --trim-n -o ${data_path} --no_report_file --basename ${out_name} > ${log_path}/${out_name}/${out_name}.TrimGalore.log 2>&1
    bsmap -p 10 -a ${data_path}/${out_name}_val_1.fq.gz -b ${data_path}/${out_name}_val_2.fq.gz -d ${mapping_index} -D C-CGG -w 100 -s 12 -v 0.1 -n 1 -m 32 -x 1000 -R -o ${result_path}/${out_name}/${out_name}.align.sam > ${log_path}/${out_name}/${out_name}.Mapping.log 2>&1
    rm -rf ${data_path}/${out_name}_val_1.fq.gz ${data_path}/${out_name}_val_2.fq.gz
    
    # Remove duplicate reads
    samtools view -@ 5 -H ${bam_path}/${out_name}.bam > ${bam_path}/${out_name}.Filtered.sam
    samtools view -@ 5 -f 0x2 ${bam_path}/${out_name}.bam | awk 'NR % 2 == 1{mapq=$5;forward=$0} NR % 2 == 0{if($5>=30 && mapq>=30 && substr($3,1,3)=="chr" && $3!="chrM") print forward"\n"$0}' >> ${bam_path}/${out_name}.Filtered.sam
    samtools view -@ 5 -bS ${bam_path}/${out_name}.Filtered.sam > ${bam_path}/${out_name}.Filtered.bam
    rm ${bam_path}/${out_name}.Filtered.sam 
    samtools sort -@ 5 -n -o ${bam_path}/${out_name}.Sort.bam ${bam_path}/${out_name}.Filtered.bam
    rm ${bam_path}/${out_name}.Filtered.bam
    samtools fixmate -@ 5 -m ${bam_path}/${out_name}.Sort.bam ${bam_path}/${out_name}.FixMate.bam
    rm ${bam_path}/${out_name}.Sort.bam
    samtools sort -@ 5 -o ${bam_path}/${out_name}.FixMateSorted.bam ${bam_path}/${out_name}.FixMate.bam
    rm ${bam_path}/${out_name}.FixMate.bam
    samtools markdup -@ 5 -r ${bam_path}/${out_name}.FixMateSorted.bam ${bam_path}/${out_name}.bam
    rm ${bam_path}/${out_name}.FixMateSorted.bam
 
else
    echo "The experiment layout should be either 'single' end or 'pair' end."
fi

# 2.methylation level calculation -----------------------------------------------------------------------------
echo "2.methylation level calculation..."
samtools view ${bam_path}/${out_name}.bam > ${bam_path}/${out_name}.sam
mcall -m ${bam_path}/${out_name}.sam -p 4 -r ${mapping_index} --outputDir ${result_path}/${out_name}
rm ${bam_path}/${out_name}.sam

echo "Done!"
echo "--------------------------------------------------------------------------------" 

